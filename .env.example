# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=3000

# ============================================================
# ADMIN CREDENTIALS (CHANGE PASSWORD BEFORE GOING LIVE!)
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChawlaClasses@2026
ADMIN_PASSWORD_HASH=

# ============================================================
# JWT SECURITY
# ============================================================
JWT_SECRET=mysecretkey123
JWT_EXPIRY=24h

# ============================================================
# DATABASE
# ============================================================
DB_PATH=./data

# ============================================================
# BCRYPT SETTINGS
# ============================================================
BCRYPT_ROUNDS=12

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_ATTEMPTS=10

# ============================================================
# ACCOUNT LOCKOUT
# ============================================================
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MS=900000

# ============================================================
# FILE UPLOAD LIMITS (in MB)
# ============================================================
MAX_FILE_SIZE_MB=25
MAX_PDF_SIZE_MB=28

# ============================================================
# OCR CONFIGURATION
# ============================================================
MAX_OCR_PAGES=50
OCR_CONCURRENCY=3

# ============================================================
# DEBUG FLAGS
# ============================================================
DEBUG_PDF=false

# ============================================================
# CORS ALLOWED ORIGINS (comma separated)
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# PROXY CONFIGURATION
# ============================================================
TRUST_PROXY=1


# ============================================================
# CSRF ENFORCEMENT (Phase 2 follow-up, 2026-08-02)
# ============================================================
# CSRF_ENFORCE=true

# ============================================================
# SESSION (Phase 2 — backs CSRF token storage, express-session)
# ============================================================
# Optional. Falls back to the app's resolved JWT_SECRET (services/auth.js)
# if unset, so this has zero effect on whether the app boots — but sharing
# one secret between JWT signing and session cookies is not ideal for a
# real deployment. Set your own random value in production.
# SESSION_SECRET=

# ============================================================
# ERROR TRACKING (Phase 2 — Sentry)
# ============================================================
# Optional. Sentry only initializes when this is set AND NODE_ENV=production
# (see app.js) — a true no-op in dev/test either way.
# SENTRY_DSN=

# ============================================================
# GENERAL API RATE LIMITER (Phase 2 — app.js, all of /api)
# ============================================================
# Both optional, safe defaults shown. Distinct from the existing per-route
# limiters in middleware/rateLimit.js (login, test-taking, etc.), which are
# unaffected by these.
# GENERAL_RATE_LIMIT_MAX=2000
# GENERAL_RATE_LIMIT_WINDOW_MIN=15

# Optional, comma-separated. IPs in this list skip the general API rate
# limiter above entirely (e.g. a known office/NAT IP shared by many staff).
# Empty/unset = no IP is exempt.
# ADMIN_IPS=
