# ============================================================
# SERVER CONFIGURATION
# ============================================================
NODE_ENV=development
PORT=3000

# ============================================================
# ADMIN CREDENTIALS (CHANGE PASSWORD BEFORE GOING LIVE!)
# ============================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChawlaClasses@2026
ADMIN_PASSWORD_HASH=

# ============================================================
# JWT SECURITY
# ============================================================
JWT_SECRET=mysecretkey123
JWT_EXPIRY=24h

# ============================================================
# DATABASE (MongoDB)
# ============================================================
# Required. The app used to persist to Data/*.json on disk; it now
# persists to MongoDB. Paste your Atlas (or any standard mongodb://) URI
# here. Example Atlas format:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/chawla_classes?retryWrites=true&w=majority
MONGODB_URI=

# Optional. Only needed if your MONGODB_URI does NOT already include a
# database name in its path (Atlas connection strings usually do) — set
# this to override/choose the database explicitly.
# MONGODB_DB_NAME=chawla_classes

# Legacy — no longer used now that the app persists to MongoDB. Kept here
# only because some of the older scripts/backup.js-style tooling still
# references it for on-disk backup snapshots.
DB_PATH=./data

# ============================================================
# BCRYPT SETTINGS
# ============================================================
BCRYPT_ROUNDS=12

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_ATTEMPTS=10

# ============================================================
# ACCOUNT LOCKOUT
# ============================================================
ACCOUNT_LOCK_MAX_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MS=900000

# ============================================================
# FILE UPLOAD LIMITS (in MB)
# ============================================================
MAX_FILE_SIZE_MB=25
MAX_PDF_SIZE_MB=28

# ============================================================
# OCR CONFIGURATION
# ============================================================
MAX_OCR_PAGES=50
OCR_CONCURRENCY=3

# ============================================================
# DEBUG FLAGS
# ============================================================
DEBUG_PDF=false

# ============================================================
# CORS ALLOWED ORIGINS (comma separated)
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================
# PROXY CONFIGURATION
# ============================================================
TRUST_PROXY=1


# ============================================================
# CSRF ENFORCEMENT (Phase 2 follow-up, 2026-08-02)
# ============================================================
# CSRF_ENFORCE=true

# ============================================================
# SESSION (Phase 2 — backs CSRF token storage, express-session)
# ============================================================
# Optional. Falls back to the app's resolved JWT_SECRET (services/auth.js)
# if unset, so this has zero effect on whether the app boots — but sharing
# one secret between JWT signing and session cookies is not ideal for a
# real deployment. Set your own random value in production.
# SESSION_SECRET=

# ============================================================
# ERROR TRACKING (Phase 2 — Sentry)
# ============================================================
# Optional. Sentry only initializes when this is set AND NODE_ENV=production
# (see app.js) — a true no-op in dev/test either way.
# SENTRY_DSN=

# ============================================================
# GENERAL API RATE LIMITER (Phase 2 — app.js, all of /api)
# ============================================================
# Both optional, safe defaults shown. Distinct from the existing per-route
# limiters in middleware/rateLimit.js (login, test-taking, etc.), which are
# unaffected by these.
# GENERAL_RATE_LIMIT_MAX=2000
# GENERAL_RATE_LIMIT_WINDOW_MIN=15

# Optional, comma-separated. IPs in this list skip the general API rate
# limiter above entirely (e.g. a known office/NAT IP shared by many staff).
# Empty/unset = no IP is exempt.
# ADMIN_IPS=

# ============================================================
# ADMISSION FORM + CAREER FORM ANTI-SPAM (2026-08 hardening)
# ============================================================
# All optional, safe defaults shown (see config/index.js). Covers the
# email-OTP flow (services/formOtpService.js), disposable-email blocklist
# (utils/spamDetection.js), and the per-IP hourly caps on the two public
# forms' final submit (routes/publicEnquiry.js /admission,
# routes/recruitment.js /apply). No paid SMS/mobile OTP is used anywhere —
# verification is email-only, via the existing SMTP/Brevo config above.

# Comma-separated. If set, REPLACES the built-in disposable-domain list
# entirely (mailinator.com, guerrillamail.com, tempmail.com,
# 10minutemail.com, yopmail.com) rather than adding to it.
# FORM_BLOCKED_EMAIL_DOMAINS=

# FORM_OTP_EXPIRY_MIN=10
# FORM_OTP_VERIFY_TOKEN_MIN=30
# FORM_OTP_MAX_RESEND=3
# FORM_OTP_RESEND_WINDOW_MIN=60
# FORM_OTP_RESEND_COOLDOWN_SEC=60
# FORM_OTP_MAX_VERIFY_ATTEMPTS=5

# Per-IP hourly cap on the actual final submit (after OTP is verified).
# ADMISSION_HOURLY_LIMIT=3
# CAREER_HOURLY_LIMIT=2

# Minimum gap between two successful submissions from the same IP.
# FORM_SUBMIT_COOLDOWN_SEC=60

# ============================================================
# CLOUDFLARE R2 (file storage)
# ============================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_api_token_access_key
R2_SECRET_ACCESS_KEY=your_r2_api_token_secret
R2_BUCKET_NAME=chawla-classes-uploads
R2_PUBLIC_URL=https://files.yourdomain.com
