{
  "name": "chawla-classes-server",
  "version": "2.1.0",
  "description": "Chawla Classes - Complete Education Management System",
  "main": "server.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/health-check.js",
    "setup": "node scripts/setup.js",
    "create-admin": "node scripts/create-admin.js",
    "create-student": "node scripts/create-student.js",
    "fix-json": "node scripts/fix-json.js",
    "init-data": "node scripts/init-data.js",
    "reset-password": "node scripts/reset-student-password.js",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "lint": "eslint . --max-warnings 0 || echo 'Linting issues found'",
    "lint:fix": "eslint . --fix",
    "health-check": "node scripts/health-check.js",
    "docker:build": "docker build -t chawla-classes:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "migrate:backup": "node scripts/backup-data.js",
    "audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "async": "^3.2.6",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^7.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.5.0",
    "nodemailer": "^6.9.14",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdf-poppler": "^0.2.1",
    "pdfkit": "^0.19.1",
    "redis": "^4.7.1",
    "sharp": "^0.35.3",
    "tesseract.js": "^5.0.3",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "optionalDependencies": {
    "file-type": "^19.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "education",
    "coaching",
    "exam",
    "test",
    "learning",
    "chawla-classes"
  ],
  "author": "Chawla Classes",
  "license": "MIT",
  "type": "commonjs"
}
